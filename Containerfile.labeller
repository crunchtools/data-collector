# The labeller: Claude Code, on the Claude subscription, with no tools,
# labelling each document for the answer key (docs/labelling.md). Built on
# Josui's image, which carries a pinned Claude Code on UBI 10, and adds the
# same package directory as the collector's image. Only `label`, `store` and
# the prompt are used here: the standard library only, no httpx, no Trentina.
#
# Josui's entrypoint, which assembles an agent's home and serves Remote
# Control, is replaced. Its managed settings still apply; with every tool and
# MCP server switched off they change nothing.
#
# Built, tested and pushed by GitHub Actions only.
FROM quay.io/crunchtools/josui:latest@sha256:cb90e185f3f795d4d2955dea81595b0e793b4aecbf930d8750e2aba423690fe8

LABEL maintainer="maintainer@crunchtools.com"
LABEL description="Labels collected documents with Claude Code, for data-collector's answer key"
LABEL org.opencontainers.image.source="https://github.com/crunchtools/data-collector"
LABEL org.opencontainers.image.description="Labels collected documents with Claude Code, for data-collector's answer key"
LABEL org.opencontainers.image.licenses="AGPL-3.0-or-later"

COPY src/data_collector/ /usr/lib/python3.12/site-packages/data_collector/

ENV COLLECTOR_DB=/data/collector.db \
    HOME=/tmp/home \
    CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# The owner of collector.db, as in the collector's image, with a name:
# Node, which Claude Code runs on, asks for the current user's entry.
USER root
RUN useradd --uid 65532 --no-create-home --home-dir /tmp/home --shell /sbin/nologin labeller
USER 65532
WORKDIR /tmp
ENTRYPOINT ["python3", "-m", "data_collector.label"]
CMD ["run"]
