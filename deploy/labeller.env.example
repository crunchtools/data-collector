# Copy to /srv/data-collector.crunchtools.com/config/labeller.env (mode 600).

# The Claude subscription's inference-only token: run `claude setup-token`
# as the subscription's owner and paste what it prints.
CLAUDE_CODE_OAUTH_TOKEN=REPLACE_ME

# Labeller models, as Claude Code names them. Every one of them must agree
# for a label to be final; collector.env must list the same ones.
COLLECTOR_LABELLERS=claude-opus-5-5,claude-fable-5-1

# Documents each labeller takes on per run, and agreed-benign documents the
# evaluation set holds.
COLLECTOR_LABEL_LIMIT=800
COLLECTOR_EVAL_BENIGN=200
