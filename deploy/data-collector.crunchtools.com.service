[Unit]
Description=data-collector: collect a hostile feed and screen what is new
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# Collecting takes a few minutes. Screening a new pipeline's backlog with the
# classifier on CPU takes longer: 600 documents a run, a few minutes a hundred.
TimeoutStartSec=10800
ExecStartPre=-/usr/bin/podman rm -f data-collector.crunchtools.com
ExecStartPre=/usr/bin/podman pull -q quay.io/crunchtools/data-collector:latest
ExecStart=/usr/bin/podman run \
    --rm \
    --name data-collector.crunchtools.com \
    --memory=2g --memory-swap=2g \
    --read-only --tmpfs /tmp \
    --cap-drop=all --security-opt=no-new-privileges \
    --env-file /srv/data-collector.crunchtools.com/config/collector.env \
    -v /srv/data-collector.crunchtools.com/data:/data:Z \
    quay.io/crunchtools/data-collector:latest run
# A run killed by the timeout must not outlive the unit in its container.
ExecStopPost=-/usr/bin/podman rm -f data-collector.crunchtools.com
