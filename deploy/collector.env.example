# Copy to /srv/data-collector.crunchtools.com/config/collector.env (mode 600).

# The collector's own OpenRouter key, with a spending limit set on it.
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Judge models, as OpenRouter names them. A reasoning model takes its effort
# after a colon.
COLLECTOR_MODELS=google/gemini-2.5-flash-lite,google/gemini-3.5-flash-lite,anthropic/claude-haiku-4.5,google/gemini-3.8-flash:minimal

# Documents per run, asks per document and model, asks in flight at once.
COLLECTOR_LIMIT=300
COLLECTOR_VOTES=3
COLLECTOR_CONCURRENCY=6

# Dollars a model's pass must leave on the key.
COLLECTOR_BUDGET_FLOOR=0.50
