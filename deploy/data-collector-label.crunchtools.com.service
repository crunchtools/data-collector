[Unit]
Description=data-collector: label documents with Claude Code, for the answer key
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 800 documents for each of two labellers is 80 asks of Claude Code, a minute
# or two each at low effort.
TimeoutStartSec=14400
ExecStartPre=-/usr/bin/podman rm -f data-collector-label.crunchtools.com
ExecStartPre=/usr/bin/podman pull -q quay.io/crunchtools/data-collector:latest
# HOME (/tmp/home) is on the tmpfs: Claude Code's state lasts one run. The
# data volume is the only mount. The collector's image, with labeller.env
# alone: no tool and no credential but the subscription's inference token.
ExecStart=/usr/bin/podman run \
    --rm \
    --name data-collector-label.crunchtools.com \
    --memory=2g --memory-swap=2g \
    --read-only --tmpfs /tmp \
    --cap-drop=all --security-opt=no-new-privileges \
    -e HOME=/tmp/home \
    --env-file /srv/data-collector.crunchtools.com/config/labeller.env \
    -v /srv/data-collector.crunchtools.com/data:/data:Z \
    quay.io/crunchtools/data-collector:latest label
ExecStopPost=-/usr/bin/podman rm -f data-collector-label.crunchtools.com
